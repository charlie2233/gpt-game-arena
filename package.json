{
  "name": "gpt-game-arena",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace web && npm run build --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:site",
    "test:site": "node scripts/validate-static-site.mjs",
    "start": "npm run start --workspace server",
    "dev": "npm run dev --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "preview": "npm run preview --workspace web"
  }
}
