PORT=8000
PUBLIC_BASE_URL=https://games.example.com
GAME_STORE_PATH=/data/game-sessions.json
GAME_STORE_TTL_MS=2592000000
GAME_STORE_MAX_SESSIONS=1000
GAME_STORE_LEGACY_BACKUP_TTL_MS=604800000
# Leave proxy trust unset until the hosted path and spoofed forwarding behavior are verified.
# Then trust forwarded client addresses only from known literal proxy IPs/CIDRs.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,2001:db8::/48
# Alternatively, for a verified fixed-length proxy path, configure the exact hop count.
# Never configure both settings.
# TRUST_PROXY_HOPS=1
# Set this only while completing the OpenAI domain-verification challenge.
# OPENAI_APPS_CHALLENGE_TOKEN=replace-with-the-portal-token
